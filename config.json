{
  "app": {
    "name": "PMOS Decision Support System",
    "version": "2.1.5",
    "environment": "production",
    "apiBaseUrl": "https://p-code-nqak.onrender.com/api/",
    "frontendUrl": "https://p-code.web.app/"
  },
  "authentication": {
    "enabled": true,
    "methods": ["email", "google", "microsoft"],
    "sessionTimeout": 3600,
    "tokenRefreshInterval": 1800,
    "maxLoginAttempts": 5,
    "lockoutDuration": 900
  },
  "mlModels": {
    "xgboost": {
      "endpoint": "https://p-code-nqak.onrender.com/predict-xgboost",
      "version": "2.1.5",
      "threshold": 0.5,
      "confidenceThreshold": 0.85
    },
    "cnn": {
      "endpoint": "https://p-code-nqak.onrender.com/predict-cnn",
      "version": "2.1.5",
      "inputSize": [224, 224],
      "channels": 3,
      "threshold": 0.5,
      "confidenceThreshold": 0.90
    },
    "cnnEigencam": {
      "endpoint": "https://p-code-nqak.onrender.com/predict-cnn-gradcam",
      "aliasOf": "predict-cnn-gradcam"
    },
    "xai": {
      "shap": {
        "endpoint": "https://p-code-nqak.onrender.com/predict-xgboost",
        "plotTypes": ["force", "summary", "dependence"],
        "maxDisplayFeatures": 10
      },
      "eigencam": {
        "endpoint": "https://p-code-nqak.onrender.com/predict-cnn-gradcam"
      }
    }
  },
  "database": {
    "type": "mysql",
    "host": "${DB_HOST}",
    "port": 3306,
    "name": "${DB_NAME}",
    "ssl": true,
    "poolSize": 5,
    "timeout": 30000,
    "note": "Production uses Clever Cloud MySQL via Render Flask (not PostgreSQL)."
  },
  "security": {
    "cors": {
      "enabled": true,
      "allowedOrigins": [
        "https://p-code.web.app",
        "https://project-a3473fa6-d957-4693-96a.firebaseapp.com",
        "http://localhost",
        "http://127.0.0.1"
      ],
      "allowedMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
      "allowedHeaders": ["Content-Type", "Authorization", "X-API-Key"]
    },
    "rateLimit": {
      "enabled": true,
      "windowMs": 60000,
      "maxRequests": 100
    }
  },
  "features": {
    "realTimeUpdates": true,
    "export": {
      "pdf": true,
      "csv": true,
      "json": true
    }
  },
  "logging": {
    "level": "info",
    "format": "json",
    "retentionDays": 90
  }
}
