# P-Code — Hostinger KVM 2 / production environment
# Copy to config/.env and fill in real values. Never commit .env.

# --- App URLs (use your real domain; include /pcode if app is in a subfolder) ---
PCODE_BASE_URL=https://YOUR_DOMAIN.com/
FRONTEND_URL=https://YOUR_DOMAIN.com/
API_BASE_URL=https://YOUR_DOMAIN.com/api/
# Comma-separated allowed browser origins for CORS (no * in production)
PCODE_CORS_ORIGINS=https://YOUR_DOMAIN.com,https://www.YOUR_DOMAIN.com

# --- MySQL (create DB + user in Hostinger / phpMyAdmin or CLI) ---
PCODE_DB_HOST=localhost
PCODE_DB_USER=pcode_user
PCODE_DB_PASS=CHANGE_ME_STRONG_PASSWORD
PCODE_DB_NAME=pcode

# --- JWT (min 32 chars; generate: openssl rand -hex 32) ---
PCODE_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_HEX_SECRET_AT_LEAST_32_CHARS

# --- Debug (always false on public hosting) ---
PCODE_DEBUG=false

# --- Google OAuth (GIS) ---
PCODE_GOOGLE_CLIENT_ID=953442697406-1nisk0lf775augnlkbbftpk19g4fkgl3.apps.googleusercontent.com

# --- Google Maps (restrict by HTTP referrer in Google Cloud Console) ---
PCODE_GOOGLE_MAPS_API_KEY=AIzaSyCIl3LDXufPtpKn7sxZMTN6DywQJokMpA0

# --- Firebase ---
PCODE_FIREBASE_WEB_API_KEY=AIzaSyCQo5PMVcPN-49y3onIyoy3yzoDZNn3ab0
PCODE_FIREBASE_PROJECT_ID=project-a3473fa6-d957-4693-96a

# --- Optional: force HTTPS at app layer (Apache also redirects) ---
PCODE_FORCE_HTTPS=true
